# Licences and signing keys — never commit.
# tdtpcli looks for ./tdtp.lic in the working directory by default, so the
# natural place to drop a licence is the repo root. The vendor signing key
# (tdtp-license keygen) must stay offline.
tdtp.lic
*.lic
*.priv
vendor.priv

# Python bytecode.
# Пакет bindings/python и наборы tests/cli — обычные Python-модули, поэтому
# __pycache__ появляется в четырёх местах дерева. Правило без слеша в начале
# ловит их все, а не только корневое.
__pycache__/
*.py[cod]

# travel-agency runtime state: checkpoints, orchestrator DB, rendered scenarios
examples/travel-agency/state/

# Local scratch. The leading underscore also hides it from the go tool, so a
# stray `package main` here cannot break `go build ./...` — see _local/README.md.
_local/

# Local run artifacts and machine-specific configs
dump_users/
baseline_*.yaml
my_sqlite_config.yaml
examples/travel-agency/logs/

# Credentials for the S3 dev tests — never commit
tests/cli/s3_dev_credentials.yaml

